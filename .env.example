# --- Base de datos (obligatorio) ---
# PostgreSQL. En Netlify usar la cadena AGRUPADA (pooled) que da el proveedor:
# sin eso, cada función abre su propia conexión y se agota el límite.
#
#   Netlify DB / Neon:  postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/netflow?sslmode=require
#   Supabase:           postgresql://postgres:clave@db.xxx.supabase.co:6543/postgres
#   Local:              postgresql://netflow@localhost:5432/netflow?sslmode=disable
DATABASE_URL=

# --- Sesiones (obligatorio en producción) ---
# Firma las cookies de sesión. Generar con: openssl rand -hex 32
# Si se cambia, se cierran todas las sesiones abiertas.
SESSION_SECRET=cambiar-esto-por-una-clave-larga-y-aleatoria

# --- Zona horaria ---
TZ=America/Argentina/Buenos_Aires

# --- Archivos adjuntos ---
# En Netlify se usa Netlify Blobs automáticamente y esto se ignora.
# Fuera de Netlify, carpeta donde se guardan los adjuntos.
UPLOADS_DIR=./data/uploads

# --- Seed inicial (solo lo lee `npm run db:seed`) ---
SEED_ADMIN_EMAIL=netflow.contacto@gmail.com
SEED_ADMIN_PASSWORD=

# --- Integraciones (V2/V3). Vacías = integración cerrada; la app funciona igual. ---
# Token compartido que deben enviar los webhooks entrantes en el header X-NetFlow-Token
INTEGRATIONS_INBOUND_TOKEN=
# Calendly (webhook firmado)
CALENDLY_WEBHOOK_SIGNING_KEY=
# Google Calendar (V2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Meta Ads (V3)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
