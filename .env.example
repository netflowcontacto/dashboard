# --- Sesiones ---
# Clave para firmar las cookies de sesion. Generar con: openssl rand -hex 32
SESSION_SECRET=cambiar-esto-por-una-clave-larga-y-aleatoria

# --- Base de datos ---
# Ruta del archivo SQLite. Por defecto ./data/netflow.db
DATABASE_PATH=./data/netflow.db

# --- Seed inicial (solo se usa al correr `npm run db:seed`) ---
SEED_ADMIN_EMAIL=netflow.contacto@gmail.com
SEED_ADMIN_PASSWORD=cambiar-en-el-primer-login

# --- Integraciones (V2). Vacias = integracion desactivada, la app funciona igual. ---
# Token compartido que deben enviar los webhooks entrantes en el header X-NetFlow-Token
INTEGRATIONS_INBOUND_TOKEN=
# Calendly (webhook firmado)
CALENDLY_WEBHOOK_SIGNING_KEY=
# Google Calendar (V2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Meta Ads (V3)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
